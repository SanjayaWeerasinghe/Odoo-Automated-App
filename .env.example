# Variables the routine's environment must define (set them in the routine/environment settings, not in a prompt or a file in git).
SHEET_ID=
STG_URL=
STG_DB=
STG_LOGIN=
STG_SECRET=
STG_UID=
KG_URL=
KG_DB=
KG_LOGIN=
KG_SECRET=
KG_UID=
GIT_TOKEN=          # fine-grained, JinStage only: contents RW, pull requests RW, issues RW; expiring
GIT_APPROVERS=      # comma-separated GitHub logins whose plan-issue comments count as the owner's decision
